save_compchem_geometry_optimisation.atoms

    _definition.id                '_compchem_geometry_optimisation.atoms'
    _alias.definition_id          '_compchem_geometry_optimisation_atoms'
    _definition.update            2026-06-04
    _description.text
;
It can be "fixed", "all", "intermolecular only", "hydrogens" or "non hydrogens"
;
    _name.category_id             'compchem_geometry_optimisation'
    _name.object_id               'atoms'
    _type.purpose                 State
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text
    _description_example.case     "all"
    loop_                      
        _enumeration_set.state 
        _enumeration_set.detail
        'fixed'                                  'no atoms position optimisation (only cell dimesions are optimised)'
        'all'                                    'an all atoms geometry optimisation.'
        'intermolecular only'                    'molecules are kept rigid and only optimise their position and orientation.'
        'hydrogens'                              'optimisation of only H atoms'
        'non hydrogens'                          'non H atoms are optimised while H atoms are kept at fixed positions/orientation from the bonded atom.'

save_

