save_compchem_geometry_optimisation.algorithm

    _definition.id                '_compchem_geometry_optimisation.algorithm'
    _alias.definition_id          '_compchem_geometry_optimisation_algorithm'
    _definition.update            2026-08-20
    _description.text
;
Geometry optimisation algorithm.
;
    _name.category_id             'compchem_geometry_optimisation'
    _name.object_id               'algorithm'
    _type.purpose                 State
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text
    loop_                      
        _enumeration_set.state 
        _enumeration_set.detail
        'BFGS'                                   'Broyden Fletcher Goldfarb Shanno Quasi Newton algorithm.'
        'LBFGS'                                  'the limited memory version of BFGS.'
        'FIRE'                                   'Fast Inertial Relaxation Engine algorithm.'
        'Steepest Descent'                       'Gradient Descent algorithm.'
        'Conjugate Gradient'                     'Conjugate Gradient Method.'
        'Other'                                  'Any other method.'

save_

