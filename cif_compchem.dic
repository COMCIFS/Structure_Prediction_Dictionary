save_compchem.calculation_type

    _definition.id                '_compchem.calculation_type'
    _alias.definition_id          '_compchem_calculation_type'
    _definition.update            2026-04-24
    _description.text
    ;
    Indicates how atomic positions are changed.

    Examples:
    "Single point"
    ;
    _name.category_id             '_compchem'
    _name.object_id               'calculation_type'
    _type.purpose                 State
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text
    loop_                      
        _enumeration_set.state 
        _enumeration_set.detail
        'Optimisation'                           ' Geometry is optimised to minimise the energy.'
        'Dynamic Ensemble'                       ' Include any calculation of a thermodynamic ensemble (e.g. microstates from MD simulations or an ensemble of phonons from lattice dynamics).'
        'Single point'                           ' No change in atomic coordinates or cell parameters.'

