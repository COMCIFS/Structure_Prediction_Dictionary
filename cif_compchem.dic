save_compchem.method

    _definition.id                '_compchem.method'
    _alias.definition_id          '_compchem_method'
    _definition.update            2026-06-04
    _description.text
;
The energy or scoring model used to rank structures.
;
    _name.category_id             'compchem'
    _name.object_id               'method'
    _type.purpose                 State
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text
    _description_example.case     "Forcefield"
    loop_                      
        _enumeration_set.state 
        _enumeration_set.detail
        'pDFT'                                   'Ranking methods based on periodic Density Functional Theory methods.'
        'Forcefield'                             'Ranking methods based on classical forcefield.'
        'Semi Empirical'                         'Ranking methods based on semi empirical approaches,'
        'Wavefunction'                           'Ranking methods based on wavefunction approaches.'
        'ML Potentials'                          'Ranking methods based on Ml potentials. Forcefields parameterised with ML, should be under the Forcefield category.'
        'Other'                                  'Any other method.'

save_

